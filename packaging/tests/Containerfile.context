ARG PROBE_IMAGE=docker.io/library/golang:1.24.13-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac
FROM ${PROBE_IMAGE}
COPY . /context
RUN test -f /context/go.mod \
    && test -s /context/LICENSE \
    && test -f /context/THIRD_PARTY_NOTICES.md \
    && test -f /context/docs/third-party/context-license.txt \
    && test -f /context/internal/context-allowed.go \
    && test ! -e /context/.git/context-sentinel \
    && test ! -e /context/.sandcastle/context-sentinel \
    && test ! -e /context/internal/.git/config \
    && test ! -e /context/internal/.sandcastle/context-marker \
    && test ! -e /context/internal/.workflow/context-marker \
    && test ! -e /context/.pomeforge/context-sentinel \
    && test ! -e /context/.orchard/context-sentinel \
    && test ! -e /context/.cache/context-sentinel \
    && test ! -e /context/.swiftpm/context-sentinel \
    && test ! -e /context/.build/context-sentinel \
    && test ! -e /context/SDKs/context-sentinel \
    && test ! -e /context/workspace/context-sentinel \
    && test ! -e /context/workspaces/context-sentinel \
    && test ! -e /context/projects/context-sentinel \
    && test ! -e /context/apps/context-sentinel \
    && test ! -e /context/internal/demo.key \
    && test ! -e /context/internal/demo.pem \
    && test ! -e /context/internal/demo.xip \
    && test ! -e /context/internal/.asc/config.json \
    && test ! -e /context/internal/.pomeforge/state.json \
    && test ! -e /context/internal/.orchard/state.json \
    && test ! -e /context/internal/apps/demo/marker \
    && test ! -e /context/internal/SDKs/iPhoneOS.sdk/marker \
    && test ! -e /context/context-sentinel.xip \
    && test ! -e /context/context-sentinel.ipa \
    && test ! -e /context/context-sentinel.p8 \
    && test ! -e /context/context-sentinel.key \
    && test ! -e /context/context-sentinel.pem \
    && test ! -e /context/context-sentinel.cer \
    && test ! -e /context/context-sentinel.mobileprovision \
    && test ! -e /context/context-sentinel.pairing-record
