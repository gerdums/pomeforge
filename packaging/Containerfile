ARG GO_IMAGE=docker.io/library/golang:1.24.13-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac
ARG SWIFT_IMAGE=docker.io/library/swift:6.3.3@sha256:56ef1be2c1ca36f4c52440357dc1fcdfdb5e113587134fcadeef57c225c71b54

FROM ${GO_IMAGE} AS orchard-go-build
ENV GOTOOLCHAIN=local
WORKDIR /source
COPY . .
RUN test "$(go env GOOS)" = linux \
    && install -d /out \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -o /out/orchard ./cmd/orchard

FROM ${SWIFT_IMAGE} AS orchard-assets-build
WORKDIR /source
COPY . .
RUN test "$(uname -s)" = Linux \
    && install -d /out \
    && swift build \
        --package-path tools/asset-compiler \
        --configuration release \
        --disable-automatic-resolution \
    && install -m 0755 tools/asset-compiler/.build/release/orchard-assets /out/orchard-assets

FROM ${SWIFT_IMAGE} AS orchard-unxip-build
ARG UNXIP_VERSION=3.3.0
ARG UNXIP_REVISION=6c3990517fcc4c1db6952fccf4c562fb14097601
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        liblzma-dev=5.6.1+really5.4.5-1ubuntu0.3 \
        zlib1g-dev=1:1.3.dfsg-3.1ubuntu2.2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source/unxip
RUN git init --quiet . \
    && git remote add origin https://github.com/saagarjha/unxip.git \
    && git fetch --depth=1 origin "${UNXIP_REVISION}" \
    && test "$(git rev-parse FETCH_HEAD)" = "${UNXIP_REVISION}" \
    && git checkout --quiet --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${UNXIP_REVISION}" \
    && install -d /out \
    && git archive --format=tar --prefix="unxip-${UNXIP_VERSION}/" "${UNXIP_REVISION}" \
        | gzip -n > "/out/unxip-${UNXIP_VERSION}.tar.gz" \
    && install -m 0644 LICENSE "/out/unxip-${UNXIP_VERSION}.LICENSE" \
    && swift build --configuration release \
    && install -m 0755 .build/release/unxip /out/unxip \
    && test "$(/out/unxip --version)" = "unxip 3.3" \
    && /out/unxip --help >/dev/null

FROM ${SWIFT_IMAGE} AS orchard-runtime
RUN groupadd --gid 10001 orchard \
    && useradd --uid 10001 --gid orchard --home-dir /var/lib/orchard/home --no-create-home --shell /usr/sbin/nologin orchard \
    && install -d -o orchard -g orchard -m 0700 /var/lib/orchard \
    && install -d -o orchard -g orchard -m 0755 /workspace

COPY --from=orchard-go-build /out/orchard /usr/local/bin/orchard
COPY --from=orchard-assets-build /out/orchard-assets /usr/local/bin/orchard-assets
COPY --from=orchard-unxip-build /out/unxip /usr/local/bin/unxip
COPY --from=orchard-unxip-build /out/unxip-3.3.0.tar.gz /usr/share/orchard/sources/unxip-3.3.0.tar.gz
COPY --from=orchard-unxip-build /out/unxip-3.3.0.LICENSE /usr/share/orchard/sources/unxip-3.3.0.LICENSE
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/orchard/THIRD_PARTY_NOTICES.md
COPY docs/third-party/ /usr/share/doc/orchard/third-party/
COPY packaging/container-entrypoint /usr/local/bin/orchard-container-entrypoint

RUN test "$(unxip --version)" = "unxip 3.3" \
    && unxip --help >/dev/null \
    && unxip_ldd="$(ldd /usr/local/bin/unxip)" \
    && printf '%s\n' "$unxip_ldd" \
    && test -z "$(printf '%s\n' "$unxip_ldd" | grep -F 'not found')"

ENV ORCHARD_STATE_ROOT=/var/lib/orchard \
    HOME=/var/lib/orchard/home \
    XDG_CONFIG_HOME=/var/lib/orchard/config \
    XDG_DATA_HOME=/var/lib/orchard/data \
    XDG_CACHE_HOME=/var/lib/orchard/cache \
    XDG_STATE_HOME=/var/lib/orchard/state

USER 10001:10001
WORKDIR /workspace
VOLUME ["/var/lib/orchard"]
ENTRYPOINT ["/usr/local/bin/orchard-container-entrypoint"]
CMD ["orchard", "version"]
